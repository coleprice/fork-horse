{
  "name": "forkhorse-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/dashboard.ts",
    "./transport": "./src/transport.ts"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:fixture": "vite build --mode fixture",
