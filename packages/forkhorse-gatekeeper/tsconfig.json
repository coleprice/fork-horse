{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*.ts",
    "app/**/*.ts",
    "test/**/*.ts",
    "vite.config.ts",
    "../forkhorse-dashboard/src/**/*.tsx"
  ],
  "exclude": [
    "src/worker/**",
    "test/local/**"
  ]
}
