    "types:check": "tsc --noEmit"
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "@cloudflare/kumo": "2.14.0",
    "@phosphor-icons/react": "2.1.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@gadgets/workshop-shared": "workspace:*"
  }
}
